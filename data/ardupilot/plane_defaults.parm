# Default starting parameters for a small (1-3 kg) hand-launched fixed wing on ArduPlane 4.5+.
# Loaded first; the flightmodel stage overrides airframe-specific values (derived.param). NOT a tune: run AUTOTUNE.
# --- airframe / mixing ---
MIXING_GAIN     0.5
KFF_RDDRMIX     0.5
# --- airspeed (sensor fitted; AIRSPEED_* and TRIM_THROTTLE are derived) ---
ARSPD_USE       1
THR_MAX         100
THR_MIN         0
THR_SLEWRATE    100
# --- attitude limits / rate loops (default-ish, verify with AUTOTUNE in sim and in the air) ---
ROLL_LIMIT_DEG  45
PTCH_LIM_MAX_DEG 25
PTCH_LIM_MIN_DEG -20
RLL2SRV_TCONST  0.4
PTCH2SRV_TCONST 0.4
RLL_RATE_P      0.15
RLL_RATE_I      0.15
RLL_RATE_D      0.005
RLL_RATE_FF     0.30
PTCH_RATE_P     0.10
PTCH_RATE_I     0.10
PTCH_RATE_D     0.004
PTCH_RATE_FF    0.35
# --- navigation ---
NAVL1_PERIOD    15
NAVL1_DAMPING   0.75
WP_RADIUS       15
WP_LOITER_RAD   60
RTL_RADIUS      60
RTL_ALTITUDE    60
# --- hand launch (pusher prop) ---
TKOFF_THR_MINACC 15
TKOFF_THR_DELAY  2
TKOFF_THR_MINSPD 4
TKOFF_LVL_ALT    5
TKOFF_LVL_PITCH  15
TKOFF_THR_MAX    100
# --- battery monitor (capacity / thresholds are derived from the plan) ---
BATT_MONITOR    4
BATT_FS_VOLTSRC 1
BATT_FS_LOW_ACT 1
BATT_FS_CRT_ACT 1
# --- failsafes ---
THR_FAILSAFE    1
FS_SHORT_ACTN   0
FS_LONG_ACTN    1
FS_LONG_TIMEOUT 5
FS_GCS_ENABL    0
# --- camera trigger (channel assigned by the flightmodel stage) ---
CAM1_TYPE       1
