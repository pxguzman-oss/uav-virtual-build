# Stork (Phase 0) SITL baseline parameters for ArduPlane 4.7 + JSON/JSBSim bridge.
# Loaded AFTER generated/<model>/<model>_model.parm (servo mapping) - later files win.
# Values are a sane starting point for a 1.8 kg, 13 m/s hand-launched V-tail; they are NOT a tune.
# --- SITL plumbing (same as ArduPilot Tools/autotest/models/plane.parm) ---
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X  0.001
INS_ACC2OFFS_Y  0.001
INS_ACC2OFFS_Z  0.001
INS_ACC2SCAL_X  1.001
INS_ACC2SCAL_Y  1.001
INS_ACC2SCAL_Z  1.001
INS_GYR_CAL     0
LOG_BITMASK     65535
LOG_DISARMED    0
RC1_MIN 1000
RC1_MAX 2000
RC1_TRIM 1500
RC2_MIN 1000
RC2_MAX 2000
RC2_TRIM 1500
RC3_MIN 1000
RC3_MAX 2000
RC3_TRIM 1000
RC4_MIN 1000
RC4_MAX 2000
RC4_TRIM 1500
FLTMODE_CH 8
FLTMODE1 10
FLTMODE2 11
FLTMODE3 12
FLTMODE4 5
FLTMODE5 2
FLTMODE6 0
# --- airframe / mixing ---
MIXING_GAIN     0.5
KFF_RDDRMIX     0.5
# --- airspeed (sensor fitted on the real aircraft) ---
ARSPD_USE       1
AIRSPEED_CRUISE 13
AIRSPEED_MIN    11
AIRSPEED_MAX    20
AIRSPEED_STALL  9.5
TRIM_THROTTLE   40
THR_MAX         100
THR_MIN         0
THR_SLEWRATE    100
# --- attitude limits / rate loops (default-ish, verify with AUTOTUNE in sim and in the air) ---
ROLL_LIMIT_DEG  45
PTCH_LIM_MAX_DEG 25
PTCH_LIM_MIN_DEG -20
RLL2SRV_TCONST  0.4
PTCH2SRV_TCONST 0.4
RLL_RATE_P      0.15
RLL_RATE_I      0.15
RLL_RATE_D      0.005
RLL_RATE_FF     0.30
PTCH_RATE_P     0.10
PTCH_RATE_I     0.10
PTCH_RATE_D     0.004
PTCH_RATE_FF    0.35
# --- navigation ---
NAVL1_PERIOD    15
NAVL1_DAMPING   0.75
WP_RADIUS       15
WP_LOITER_RAD   60
RTL_RADIUS      60
RTL_ALTITUDE    60
# --- hand launch (pusher prop) ---
TKOFF_THR_MINACC 15
TKOFF_THR_DELAY  2
TKOFF_THR_MINSPD 4
TKOFF_LVL_ALT    5
TKOFF_LVL_PITCH  15
TKOFF_THR_MAX    100
# --- battery 4S2P P50B, 10 Ah ---
BATT_MONITOR    4
BATT_CAPACITY   10000
BATT_FS_VOLTSRC 1
BATT_LOW_VOLT   13.6
BATT_CRT_VOLT   12.8
BATT_LOW_MAH    2000
BATT_CRT_MAH    800
BATT_FS_LOW_ACT 1
BATT_FS_CRT_ACT 1
# --- failsafes ---
THR_FAILSAFE    1
FS_SHORT_ACTN   0
FS_LONG_ACTN    1
FS_LONG_TIMEOUT 5
FS_GCS_ENABL    0
# --- camera triggered by distance (logged as CAM / TRIG) ---
SERVO9_FUNCTION 10
CAM1_TYPE       1
